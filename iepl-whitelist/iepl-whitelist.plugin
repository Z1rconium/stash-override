#!name = IEPL 白名单自动同步
#!desc = 直连联网探测通过后同步出口 IP；每 5 分钟检查，离线每分钟重试，网络变化时立即检查。请在插件参数中填写服务地址和 token。手动执行可查看状态。
#!author = Z1rconium
#!homepage = https://github.com/Z1rconium/stash-override/tree/main/iepl-whitelist
#!loon_version = 3.5.1(983)
#!date = 2026-10-30
#!tag = 网络工具,白名单

[Argument]
api = input,"https://YOUR_DOMAIN",type=string,tag=同步服务地址,desc=填写自己的 HTTPS 地址，不带末尾斜杠，如 https://sync.example.com
token = input,"YOUR_TOKEN",type=string,tag=访问令牌,desc=服务端校验的 X-Token；不要分享填写后的配置或参数截图

# 三个 tag 用于脚本识别入口，请勿修改。
# 请求在脚本内指定 node=DIRECT，不依赖规则、代理节点或策略组健康状态。
# 无需 MitM 证书，也无需在插件中写入上游 IEPL API Key。
[Script]
cron "* * * * *" then script("https://raw.githubusercontent.com/Z1rconium/stash-override/main/iepl-whitelist/iepl-whitelist.js?v=1.2.1", {${api}, ${token}}) with tag="iepl-whitelist-cron", timeout=30
network-changed then script("https://raw.githubusercontent.com/Z1rconium/stash-override/main/iepl-whitelist/iepl-whitelist.js?v=1.2.1", {${api}, ${token}}) with tag="iepl-whitelist-network", timeout=30
generic then script("https://raw.githubusercontent.com/Z1rconium/stash-override/main/iepl-whitelist/iepl-whitelist.js?v=1.2.1", {${api}, ${token}}) with tag="iepl-whitelist-manual", img_url="checkmark.shield.system", timeout=30
