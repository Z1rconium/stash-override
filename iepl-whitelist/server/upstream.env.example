# 示例：install.sh 会替你生成 /etc/iepl-whitelist/upstream.env 与 token.env（权限 600）。
# 手动安装时参照本文件创建，并 chmod 600。⚠️ 不要把填了真实值的文件提交到仓库。
#
# 值里有 & ? 等字符时请保留双引号（systemd 与 shell 都支持）；值里不要出现双引号或换行。

# ★ 你的 IEPL 白名单 API 的完整地址（服务商后台“API 调用说明”里给出）
UPSTREAM_URL="<填你的 API 完整地址>"

# ★ 你的 API Key（只存在服务器上，不会下发给任何客户端）
UPSTREAM_API_KEY="<填你的 API Key>"

# --- token.env（单独一个文件）---
# ★ Stash / 快捷指令访问本服务用的 token；install.sh 会随机生成，自己生成可用：
#     python3 -c 'import secrets; print(secrets.token_hex(24))'
# CLIENT_TOKEN=<随机字符串>

# --- 可选项（需要时加到 upstream.env 里）---
# BIND=127.0.0.1          # 监听地址，默认只监听本机，由 Caddy 反代；不要改成 0.0.0.0
# PORT=8787               # 监听端口
# CACHE_TTL=15            # 白名单快照缓存秒数
# UPSTREAM_TIMEOUT=12     # 调用上游的超时秒数
